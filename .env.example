# ==============================================================================
# Vault Auth Backend - Example Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your own secrets before running.
# NEVER commit .env or actual credentials to version control.

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# Secret Keys & Tokens
SECRET_KEY=replace-with-strong-random-secret
TOKEN_SECRET=replace-with-strong-token-secret
TOKEN_ALGORITHM=MD5
TOKEN_EXPIRATION=3600
SESSION_EXPIRES=3600

# Database Configuration (PostgreSQL)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=postgres
DB_SSLMODE=prefer

# SMTP Email Configuration (Password Reset & Verification OTPs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional: Plunk Email Delivery API (Fallback if SMTP is not set)
PLUNK_API_KEY=
PLUNK_FROM=VaultAuth SSO <no-reply@example.com>
