# ==============================================================================
# Vault Auth Backend - Example Environment Configuration
# ==============================================================================
# Server
SERVER_PORT=5000
SERVER_HOST=0.0.0.0
SERVER_DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# Secret Keys & Tokens
SECRET_KEY=replace-with-strong-random-secret
TOKEN_SECRET=replace-with-strong-token-secret
TOKEN_ALGORITHM=HS256
TOKEN_EXPIRATION=3600
SESSION_EXPIRES=3600
TRUST_PROXY_HEADERS=false

# Database
DB_USER=postgres
DB_PORT=5432
DB_HOST=localhost
DB_NAME=postgres
DB_PASS=
DB_SSLMODE=prefer
DATABASE_URL=

# Email Configuration (Option 1: SMTP / Gmail with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Email Configuration (Option 2: Plunk Email Delivery API)
PLUNK_API_KEY=
PLUNK_FROM=VaultAuth SSO <no-reply@example.com>
